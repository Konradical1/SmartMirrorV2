# Backend location used by the Pi display and Pi voice runner.
SMARTMIRROR_BACKEND_URL=http://192.168.4.41:3001
SMARTMIRROR_BACKEND_WS=ws://192.168.4.41:3001

# Local test override. Use this when running backend + Pi apps on the Pi.
# SMARTMIRROR_BACKEND_URL=http://127.0.0.1:3001
# SMARTMIRROR_BACKEND_WS=ws://127.0.0.1:3001

PORT=3001
HOST=0.0.0.0

WEATHER_LOCATION=Anderson Township, OH
WEATHER_LATITUDE=39.0714
WEATHER_LONGITUDE=-84.3505
WEATHER_TIMEZONE=America/New_York
WEATHER_CACHE_MS=300000

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
CALENDAR_TIMEZONE=America/New_York

NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_TITLE_PROPERTY=
NOTION_DONE_PROPERTY=Done
NOTION_DONE_STATUS=Done
NOTION_TAG_PROPERTY=Tag
NOTION_DATE_PROPERTY=Due

MIRROR_MEMORY_PATH=./MEMORY.md
JARVIS_MEMORY_DIR=./.jarvis-memory
JARVIS_VECTOR_STORE=json
JARVIS_VECTOR_DB_PATH=./.jarvis-memory/lancedb
JARVIS_RAG_ENABLED=true
JARVIS_MEMORY_AUTO_SAVE=true
JARVIS_MEMORY_AUTO_MIN_CONFIDENCE=0.72
JARVIS_MEMORY_AUTO_MAX_FACTS=3
JARVIS_MEMORY_CONSOLIDATION_MAX_TOKENS=320
JARVIS_MEMORY_TOP_K=6
JARVIS_MEMORY_CHUNK_CHARS=1800
JARVIS_MEMORY_RECENCY_HALFLIFE_DAYS=45
JARVIS_PROMPT_AUTO_REWRITE=true
JARVIS_PROMPT_OVERLAY_MAX_CHARS=2400
EMBEDDINGS_PROVIDER=openrouter
OPENROUTER_EMBEDDINGS_MODEL=openai/text-embedding-3-small
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

VOICE_MONKEY_TOKEN=
VOICE_MONKEY_DEVICE_BRIGHT_LIGHTS=brightlights
VOICE_MONKEY_DEVICE_DIM=dim
VOICE_MONKEY_DEVICE_FAN_OFF=fan-off
VOICE_MONKEY_DEVICE_FAN_ON=fan-on
VOICE_MONKEY_DEVICE_LIGHTS_OFF=lightsoff
VOICE_MONKEY_TIMEOUT_MS=5000

# LLM provider for non-fast-path requests: sambanova, openai, openrouter, gemini, or cerebras.
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
LLM_MAX_TOKENS=240
LLM_TEMPERATURE=0.2
LLM_TOP_P=1
LLM_FALLBACK_PROVIDER=openrouter
LLM_ROUTER_TIMEOUT_MS=1800
LLM_RESPONSE_TIMEOUT_MS=2500
LLM_MEMORY_TIMEOUT_MS=2500
LLM_TIMEOUT_MS=3000
JARVIS_ROUTER_MAX_TOKENS=120
JARVIS_ROUTER_TEMPERATURE=0.12
JARVIS_RESPONSE_MAX_TOKENS=90
JARVIS_RESPONSE_TEMPERATURE=0.5
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash-latest
CEREBRAS_API_KEY=
