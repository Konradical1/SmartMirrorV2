# Backend location used by the Pi display and Pi voice runner.
SMARTMIRROR_BACKEND_URL=http://192.168.4.41:3001
SMARTMIRROR_BACKEND_WS=ws://192.168.4.41:3001

# Local test override. Use this when running backend + Pi apps on the Pi.
# SMARTMIRROR_BACKEND_URL=http://127.0.0.1:3001
# SMARTMIRROR_BACKEND_WS=ws://127.0.0.1:3001

PORT=3001
HOST=0.0.0.0

WEATHER_LOCATION=Anderson Township, OH
WEATHER_LATITUDE=39.0714
WEATHER_LONGITUDE=-84.3505
WEATHER_TIMEZONE=America/New_York
WEATHER_CACHE_MS=300000

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
CALENDAR_TIMEZONE=America/New_York

NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_TITLE_PROPERTY=
NOTION_DONE_PROPERTY=Done
NOTION_DONE_STATUS=Done
NOTION_TAG_PROPERTY=Tag
NOTION_DATE_PROPERTY=Due

MIRROR_MEMORY_PATH=./MEMORY.md

VOICE_MONKEY_TOKEN=
VOICE_MONKEY_DEVICE_BRIGHT_LIGHTS=brightlights
VOICE_MONKEY_DEVICE_DIM=dim
VOICE_MONKEY_DEVICE_FAN_OFF=fan-off
VOICE_MONKEY_DEVICE_FAN_ON=fan-on
VOICE_MONKEY_DEVICE_LIGHTS_OFF=lightsoff
VOICE_MONKEY_TIMEOUT_MS=5000

# LLM provider for non-fast-path requests: groq, sambanova, openai, openrouter, gemini, or cerebras.
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
LLM_MAX_TOKENS=240
LLM_TEMPERATURE=0.2
LLM_TOP_P=1
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash-latest
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b

# Pi voice.
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
TTS_PROVIDER=inworld
INWORLD_API_KEY=
INWORLD_VOICE_ID=Craig
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
VOICE_WAKE_MODEL=hey_jarvis
VOICE_WAKE_MODEL_PATH=
VOICE_WAKE_THRESHOLD=0.45
VOICE_FRAME_MS=80
VOICE_PRE_ROLL_MS=1200
VOICE_WAKE_UTTERANCE_MAX_MS=20000
VOICE_WAKE_UTTERANCE_SILENCE_MS=900
VOICE_CHAT_MAX_RECORD_MS=20000
VOICE_CHAT_END_SILENCE_MS=700
VOICE_CHAT_QUICK_END_SILENCE_MS=520
VOICE_CHAT_QUICK_END_AFTER_SPEECH_MS=1000
VOICE_CHAT_NO_SPEECH_TIMEOUT_MS=4500
VOICE_CHAT_SILENCE_RMS=0.012
VOICE_CONVERSATION_SILENCE_MS=5000
AUDIO_PLAYBACK_PREROLL_MS=250
# Leave this as `auto` to prefer the Pi headphone jack / analog output when present.
AUDIO_PLAYBACK_DEVICE=auto
# Leave this as `auto` to prefer a non-Rode USB capture device when present.
AUDIO_DEVICE=auto
